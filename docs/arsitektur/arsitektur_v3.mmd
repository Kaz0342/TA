    class DashAggr,BaglogSrv,HarvestSrv,SalesSrv,SlotRecords,BaglogRecords,HarvestRecords,SalesRecords farmNode;
    class DeviceControl,SprinklerLogs,SensorSrv,SensorRepo,SensorReadings,ThresholdSettings climNode;
