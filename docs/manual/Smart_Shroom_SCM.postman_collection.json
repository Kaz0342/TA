            "description": "Menampilkan ranking performa supplier berbobot: defect tiba (35%), mortalitas (25%), produktivitas (25%), HPP (15%)."
          }
        },
        {
          "name": "1.4 Detail Scorecard Individual Supplier ID 1",
          "request": {
            "method": "GET",
            "header": [
