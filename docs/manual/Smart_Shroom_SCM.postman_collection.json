              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers/1/scorecard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "suppliers",
                "1",
                "scorecard"
              ]
            }
          }
        },
        {
          "name": "1.5 Pengadaan Batch Baru dengan Cacat Kedatangan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": 1,\n  \"entry_date\": \"2026-10-31\",\n  \"initial_quantity\": 500,\n  \"price_per_baglog\": 2800,\n  \"rejected_at_arrival\": 15,\n  \"notes\": \"Pengadaan bibit batch uji coba demo sidang - 15 bibit cacat dipisahkan saat tiba\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/baglogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "baglogs"
              ]
            },
            "description": "Menguji isolasi bibit rusak saat tiba (15 cacat masuk culls CACAT_KEDATANGAN, kuota siap rak = 485)."
          }
        }
      ]
    },
    {
