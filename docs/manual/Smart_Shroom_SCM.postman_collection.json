{
  "info": {
    "_postman_id": "smart-shroom-scm-collection-2026",
    "name": "Smart Shroom SCM — Official API Demo Collection",
    "description": "Koleksi API resmi demonstrasi sidang Tugas Akhir untuk sistem Smart Shroom SCM (Backend Laravel 13). Mencakup autentikasi Sanctum, SCM Hulu (Supplier Scorecard), SCM Tengah (Restock DSS), dan SCM Hilir (Dual-Direction Traceability).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth & Security",
      "item": [
        {
          "name": "0.1 Login Admin (Auto-Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('Sanctum Token saved successfully!');",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartshroom.test\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login sebagai akun Admin untuk mendapatkan token akses Laravel Sanctum."
          }
        },
        {
          "name": "0.2 Verifikasi Proteksi RBAC (Tanpa Token -> 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "suppliers"
              ]
            },
            "description": "Membuktikan endpoint SCM diproteksi otorisasi server-side. Tanpa token akan menghasilkan 401 Unauthorized."
          }
        },
        {
          "name": "0.3 Profil Pengguna Terautentikasi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - SCM Hulu (Supplier Scorecard)",
      "item": [
        {
          "name": "1.1 Daftar Seluruh Pemasok Bibit Aktif",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers?active_only=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "suppliers"
              ],
              "query": [
                {
                  "key": "active_only",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "1.2 Pendaftaran Pemasok Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CV Jamur Sejahtera Sleman\",\n  \"contact_person\": \"Haji Slamet\",\n  \"phone\": \"081298765432\",\n  \"address\": \"Jl. Kaliurang KM 14, Sleman, D.I. Yogyakarta\",\n  \"lead_time_days\": 5,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "suppliers"
              ]
            }
          }
        },
        {
          "name": "1.3 Matriks Komparasi Supplier (Scorecard Matrix A/B/C/D)",
